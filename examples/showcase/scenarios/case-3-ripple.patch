new file mode 100644
index 0000000..c769233
--- /dev/null
+++ b/dags/common/cmd.py
@@ -0,0 +1,12 @@
+"""Shared command builders for showcase DAGs."""
+from __future__ import annotations
+
+
+def build_report_cmd(name: str) -> str:
+    """Build a report-generator command with the active tenant prepended.
+
+    The Jinja `{{ var.value.tenant_id }}` is rendered per-DAG-run, so every
+    task that goes through this helper will pick up tenant routing without
+    each DAG having to know about it.
+    """
+    return f"report.sh {name} --tenant {{{{ var.value.tenant_id }}}}"
